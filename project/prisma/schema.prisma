generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  sentMessages    messages[] @relation("sender")
  receivedMessages messages[] @relation("receiver")
  groupMemberships groupMember[]
  createdGroups      group[] @relation("GroupCreator")
}

model messages {
  id         Int      @id @default(autoincrement())
  text       String
  senderID   Int
  receiverID Int?
  groupID    Int?
  createdAt  DateTime @default(now())

  sender     user     @relation("sender", fields: [senderID], references: [id])
  receiver   user?    @relation("receiver", fields: [receiverID], references: [id])
  group      group?   @relation("groupMessages", fields: [groupID], references: [id])

  @@index([receiverID], map: "messages_receiverID_fkey")
  @@index([senderID], map: "messages_senderID_fkey")
  @@index([groupID], map: "messages_groupID_fkey")
}

model group {
  id        Int       @id @default(autoincrement())
  name      String
  creatorId Int
  createdAt DateTime @default(now())
  messages  messages[] @relation("groupMessages")
  members   groupMember[]

  creator   user      @relation("GroupCreator", fields: [creatorId], references: [id])
}

model groupMember {
  userId   Int
  groupId  Int
  user     user     @relation(fields: [userId], references: [id])
  group    group    @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}
